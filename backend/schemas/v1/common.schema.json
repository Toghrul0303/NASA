{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spherex-sky-explorer/schema/v1/common.schema.json",
  "$defs": {
    "schema_version": {
      "const": "1.0.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "data_version": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iso_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "mjd": {
      "type": "number",
      "minimum": 60000,
      "maximum": 70000
    },
    "ra_deg": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "dec_deg": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "detector": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "channel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 101
    },
    "release": {
      "enum": [
        "dr1",
        "qr3"
      ]
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "size_deg": {
      "enum": [
        0.05,
        0.1,
        0.2
      ]
    },
    "flag_name": {
      "enum": [
        "TRANSIENT",
        "OVERFLOW",
        "SUR_ERROR",
        "PHANTOM",
        "REFERENCE",
        "NONFUNC",
        "DICHROIC",
        "MISSING_DATA",
        "HOT",
        "COLD",
        "FULLSAMPLE",
        "PHANMISS",
        "NONLINEAR",
        "PERSIST",
        "OUTLIER"
      ]
    },
    "flag_fractions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/flag_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fraction"
      },
      "minProperties": 15,
      "maxProperties": 15
    },
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "triple_nullable_number": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}
